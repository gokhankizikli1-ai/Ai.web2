# Billing environment — example (NO secret values; placeholders only).
# Backend-only. NONE of these may be mirrored to a VITE_* variable.
# Every accessor reads the env dynamically, so a Railway flip is live without a restart.
# See docs/billing/POLAR_MIGRATION.md and backend/core/config.py for canonical docs.

# ── Provider selection (PR #522) ─────────────────────────────────────────────
# Active billing provider. Default + fail-safe: lemon_squeezy. Setting "polar"
# makes checkout fail closed (503) until PR #524. Backend-only — never VITE_.
BILLING_PROVIDER=lemon_squeezy

# ── Lemon Squeezy — REQUIRED NOW (while Lemon is the production provider) ─────
ENABLE_BILLING=false                      # master gate for the webhook surface
ENABLE_BILLING_CHECKOUT=false             # gate for POST /v2/billing/checkout
LEMON_SQUEEZY_WEBHOOK_SECRET=             # SECRET — signing secret (fails closed when empty)
LEMON_SQUEEZY_API_KEY=                    # SECRET — Bearer API key for checkout creation
LEMON_SQUEEZY_STORE_ID=                   # store the checkouts belong to
LEMON_SQUEEZY_API_BASE=https://api.lemonsqueezy.com
# LEMON_SQUEEZY_WEBHOOK_MAX_BYTES=524288  # optional (default 512 KiB)

# ── Plan / product mapping (provider-neutral data; remap for Polar later) ─────
# Checkout catalog: selector → {variant_id|product_id|price_id, plan, [provider]}.
# Lemon entries keep variant_id; a Polar entry uses provider+product_id/price_id.
BILLING_CHECKOUT_VARIANTS_JSON={}
# Provider-id → plan-key map, keys "variant:<id>" / "product:<id>" / "price:<id>".
BILLING_PLAN_MAP_JSON={}
# Plan catalog (name/rank/features/limits). Built-in "free" always exists.
BILLING_PLAN_CATALOG_JSON={}
BILLING_DEFAULT_PLAN=free

# ── Polar — IMPLEMENTED in PR #524 (dormant until BILLING_PROVIDER=polar) ──────
# Provision in SANDBOX first. Required to ACTIVATE Polar:
#   - checkout needs POLAR_ACCESS_TOKEN + POLAR_ORGANIZATION_ID (+ product ids in
#     BILLING_CHECKOUT_VARIANTS_JSON) when BILLING_PROVIDER=polar,
#   - the Polar webhook route needs POLAR_WEBHOOK_SECRET (independent of
#     BILLING_PROVIDER — sandbox webhooks can be validated while Lemon stays live).
# Default POLAR_SERVER=sandbox so an accidental enable can never touch live Polar.
POLAR_ACCESS_TOKEN=                        # SECRET — Organization Access Token (Bearer)
POLAR_ORGANIZATION_ID=                     # Polar organization id
POLAR_WEBHOOK_SECRET=                      # SECRET — Standard-Webhooks signing secret (whsec_…)
POLAR_SERVER=sandbox                       # sandbox | production (typo → sandbox)
# POLAR_API_BASE=                          # optional explicit base override (staging/tests)

# ── Other billing knobs (provider-neutral; KEEP unchanged) ───────────────────
# ENABLE_BILLING_PROCESSOR=false
# ENABLE_BILLING_SUBSCRIPTION_PROJECTION=true
# ENABLE_BILLING_ENTITLEMENTS=false
# ENABLE_BILLING_FEATURE_GATING=false
# ENABLE_BILLING_USAGE=false
# ENABLE_BILLING_CREDITS=false
# BILLING_ENTITLING_STATUSES=active,trialing
# BILLING_CANCELLED_GRACE=true
# Checkout return experience (PR #525): the frontend checkout return page lives at
# /billing/return. Add its absolute URL to the allowlist so the backend accepts it
# as a success_url, and (optionally) set it as the default. The backend NEVER grants
# access from this redirect — the page re-reads GET /v2/billing/me for the truth.
# BILLING_CHECKOUT_DEFAULT_RETURN_URL=https://app.example.com/billing/return
# BILLING_CHECKOUT_ALLOWED_RETURN_HOSTS=app.example.com
# BILLING_DB_PATH=  BILLING_POSTGRES_REQUIRED=false

# ── Frontend flag (PR #525) — NOT a secret, lives in the FRONTEND build only ──
# This is the ONE billing-related VITE_ var, and it is a boolean feature flag with
# NO secret content. OFF by default: with it unset, every pricing/upgrade CTA keeps
# its exact prior behaviour and no /v2/billing/checkout call is made. Set to "true"
# to activate the wired, provider-neutral checkout CTAs. It carries NO provider name,
# product id, or key — the frontend only ever sends a Korvix plan selector.
# VITE_ENABLE_CHECKOUT=false
